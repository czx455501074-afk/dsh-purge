{
  "name": "dsh-purge-czx",
  "version": "2.2.0",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-czx": "bin/dsh-purge-czx.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "dsh-go",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "diagnose": "node scripts/diagnose-patches.mjs",
    "check:prompt": "node scripts/check-prompt-render.mjs",
    "verify": "node scripts/verify-release.mjs",
    "test:ui": "node scripts/test-client-ui.mjs",
    "test:models": "node scripts/test-model-adapt.mjs",
    "test": "node scripts/verify-release.mjs && node scripts/test-client-ui.mjs && node scripts/test-model-adapt.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czx455501074-afk/dsh-purge-czx.git"
  },
  "homepage": "https://github.com/czx455501074-afk/dsh-purge-czx#readme",
  "bugs": {
    "url": "https://github.com/czx455501074-afk/dsh-purge-czx/issues"
  },
  "dsh": {
    "target": "0.2.2-rc.5",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/czx455501074-afk/dsh-purge-czx/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/czx455501074-afk/dsh-purge-czx/archive/refs/heads/master.zip",
      "git": "https://github.com/czx455501074-afk/dsh-purge-czx.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
